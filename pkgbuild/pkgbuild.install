#!/usr/bin/env bash

# This file contains scripts that are executed at different stages of package installation/upgrade/removal

# Color definitions for status messages

blueDark="\e[1;38;5;33m" # Bold dark blue

mediumBlue="\e[1;38;5;32m" # Bold medium blue

lightBlue="\e[1;38;5;39m" # Bold light blue

cyan="\e[1;38;5;45m" # Bold cyan

white="\e[1;97m" # Bold white

reset="\e[0m" # Reset text formatting

# Print status messages

printMsg() {

local message=$1

echo -e "${blueDark}[${lightBlue}pcloud-drive${blueDark}]${reset} ${cyan}→${reset} ${white}${message}${reset}"

}


# Function executed after package installation

post_install() {

printMsg "Configuring pCloud Drive after installation..."

# Update desktop database to register the application

update-desktop-database -q 2>/dev/null || true

# Update icon cache for proper icon display

gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

printMsg "Desktop integration configured successfully"

printMsg "You can now launch pCloud Drive from your applications menu or run 'pcloud' in terminal"

}


# Function executed after package upgrade

post_upgrade() {

printMsg "Finalizing package upgrade..."

# Ensure desktop entries and icons are properly updated after upgrade

post_install

printMsg "Upgrade completed successfully"

}


# Function executed before package removal

pre_remove() {

printMsg "Preparing to remove the package..."

# Stop any running pCloud processes without terminating pacman itself

pkill -x pcloud 2>/dev/null || true
pkill -f '/opt/pcloud/pcloud-drive.AppImage' 2>/dev/null || true

printMsg "Stopped running pCloud processes"

}


# Function executed after package removal

post_remove() {

printMsg "Cleaning up after package removal..."

# Update desktop database to remove application entries

update-desktop-database -q 2>/dev/null || true

# Update icon cache after removal

gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

# Remove any remaining configuration directories if they exist and are empty

if [ -d "$HOME/.pcloud" ] && [ -z "$(ls -A $HOME/.pcloud 2>/dev/null)" ]; then
    rmdir "$HOME/.pcloud" 2>/dev/null || true
fi

printMsg "Package cleanup completed"

}
