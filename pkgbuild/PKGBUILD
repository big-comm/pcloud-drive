# Contributor: Winston Astrachan
# Contributor: Plague-doctor

pkgname=pcloud-drive
pkgver=1.14.18
pkgrel=3
pkgdesc='pCloud Drive (Electron edition).'
arch=('x86_64')
url='https://www.pcloud.com/'
license=("LicenseRef-${pkgname}")
depends=('fuse2' 'zlib' 'hicolor-icon-theme')
optdepends=('libappindicator-gtk3: tray menu support')
makedepends=('curl' 'jq' 'squashfs-tools')
options=('!strip' '!debug')
install="pkgbuild.install"
replaces=('pcloud-git' 'pcloud')

_shortname='pcloud'
_appimage="${pkgname}-${pkgver}.AppImage"
_api_code='XZ2gJM5Z8pdJVlCT0s5FI1aTKxxgt48aEr8k'

source=()
sha256sums=()

prepare() {
  cd "${srcdir}"

  echo "==> Fetching download URL from the pCloud API..."
  local api_url="https://api.pcloud.com/getpublinkdownload?code=${_api_code}"
  local api_resp
  api_resp="$(curl -fsSL "${api_url}")" || {
    echo "ERROR: request to the pCloud API failed"; exit 1; }

  local dlhost dlpath
  dlhost="$(printf '%s' "$api_resp" | jq -r '.hosts[0]')" || true
  dlpath="$(printf '%s' "$api_resp" | jq -r '.path')" || true

  if [[ -z "${dlhost}" || -z "${dlpath}" || "${dlhost}" == "null" || "${dlpath}" == "null" ]]; then
    echo "ERROR: unable to extract host/path. Response: ${api_resp}"
    exit 1
  fi

  local url_download="https://${dlhost}${dlpath}"
  echo "==> Downloading AppImage: ${url_download}"
  curl -fL --output "${_appimage}" "${url_download}" || {
    echo "ERROR: failed to download the AppImage"; exit 1; }

  chmod +x "${_appimage}"

  echo "==> Extracting AppImage SquashFS payload..."
  local squash_tmp
  squash_tmp="$(mktemp "${srcdir}/appimage.XXXXXX.squashfs")"

  python - <<'PY' "${_appimage}" "${squash_tmp}"
import pathlib
import shutil
import sys

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])

with source.open('rb') as fh:
    data = fh.read()

offset = data.rfind(b'hsqs')
if offset == -1:
    raise SystemExit("ERROR: SquashFS magic 'hsqs' not found inside AppImage")

with source.open('rb') as fh, target.open('wb') as out:
    fh.seek(offset)
    shutil.copyfileobj(fh, out)
PY

  rm -rf "${srcdir}/squashfs-root"
  unsquashfs -d "${srcdir}/squashfs-root" -f "${squash_tmp}" >/dev/null || {
    echo "ERROR: failed to unpack SquashFS payload"; exit 1; }
  rm -f "${squash_tmp}"

  [[ -d "${srcdir}/squashfs-root" ]] || {
    echo "ERROR: squashfs-root directory not found after extraction"; exit 1; }
}
package() {
  cd "${srcdir}"

  [[ -d "squashfs-root" ]] || {
    echo "ERROR: squashfs-root directory not found inside package()"; exit 1; }

  install -dm755 "${pkgdir}/opt/${_shortname}"
  install -dm755 "${pkgdir}/usr/bin"
  install -dm755 "${pkgdir}/usr/share/applications"
  install -dm755 "${pkgdir}/usr/share/icons/hicolor"
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"

  # AppImage under /opt
  install -Dm755 "${_appimage}" "${pkgdir}/opt/${_shortname}/${pkgname}.AppImage"

  # Licenses (if present)
  [[ -f "squashfs-root/LICENSE.electron.txt" ]] && \
    install -Dm644 "squashfs-root/LICENSE.electron.txt" \
      "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  [[ -f "squashfs-root/LICENSES.chromium.html" ]] && \
    install -Dm644 "squashfs-root/LICENSES.chromium.html" \
      "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

  # Normalize permissions from the extracted tree (sometimes comes as 0700)
  find squashfs-root -type d -exec chmod 0755 {} \;
  find squashfs-root -type f -exec chmod 0644 {} \; 2>/dev/null || true

  # ---- ICONS: look for the hicolor theme inside the AppImage and copy everything ----
  local icon_tree
  icon_tree="$(find "squashfs-root" -type d -path '*/icons/hicolor' -print -quit)"
  if [[ -n "${icon_tree}" ]]; then
    # the "/." forces copying the full contents while keeping structure
    cp -a "${icon_tree}/." "${pkgdir}/usr/share/icons/hicolor/"
  else
    echo "WARNING: hicolor theme not found inside the AppImage."
  fi

  # Optional root icon kept at /usr/share/icons/pcloud.png
  if [[ -f "squashfs-root/pcloud.png" ]]; then
    install -Dm644 "squashfs-root/pcloud.png" \
      "${pkgdir}/usr/share/icons/pcloud.png"
  fi

  # ---- DESKTOP: locate the .desktop file inside the AppImage ----
  local desktop_file
  desktop_file="$(find "squashfs-root" -type f -name 'pcloud.desktop' -print -quit)"
  if [[ -n "${desktop_file}" ]]; then
    local desktop_target="${pkgdir}/usr/share/applications/pcloud.desktop"
    install -Dm644 "${desktop_file}" "${desktop_target}"

    # Adapt Exec to use our wrapper and disable automatic integration
    sed -i -E "s|^Exec=.*|Exec=env DESKTOPINTEGRATION=false /usr/bin/${_shortname}|" \
      "${desktop_target}"
    # Normalize the Name if it ships as "pcloud"
    sed -i "s/^Name=pcloud$/Name=pCloud/" "${desktop_target}"
  else
    echo "WARNING: pcloud.desktop not found in the extracted AppImage."
  fi

  # Wrapper in /usr/bin
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${_shortname}" << 'EOF'
#!/bin/bash
exec /opt/pcloud/pcloud-drive.AppImage "$@"
EOF

  echo "==> Packaging completed."
}
